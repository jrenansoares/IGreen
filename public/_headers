# Cloudflare Pages / Workers Static Asset Caching Rules

# 1. Immutable Long-term Cache for Fingerprinted Assets generated by Vite (/assets/*)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 2. Revalidate HTML to ensure new deploys take effect immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 3. Static Icons, Logos, and Media files
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# 4. Robots & Sitemap
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
